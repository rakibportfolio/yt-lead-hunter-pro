{
  "manifest_version": 3,
  "name": "YT Lead Hunter PRO + AI Outreach",
  "version": "2.0.0",
  "description": "Discover high-qualified YouTube creator leads, scrape verified emails, calculate retention scores, and automate outreach.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.facebook.com/*",
    "http://localhost:8000/*",
    "https://api.brightdata.com/*",
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Lead Hunter PRO",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

